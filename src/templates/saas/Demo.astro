---
import Pricing from "./Pricing";
---

<header class="mx-auto flex max-w-5xl items-center justify-between gap-4 border-b border-current/15 px-6 py-5">
  <a
    href="#main"
    class="flex min-h-11 items-center font-serif text-2xl font-bold"
  >
    Tally
  </a>
  <nav aria-label="Demo navigation" class="flex flex-wrap gap-4 text-xs">
    <a class="flex min-h-11 items-center" href="#explore">
      Pricing
    </a>
    <a class="flex min-h-11 items-center" href="#about">
      About
    </a>
  </nav>
</header>
<section
  data-motion-reveal
  class="mx-auto grid max-w-5xl items-center gap-8 px-6 py-12 md:grid-cols-2"
>
  <div>
    <p class="text-[10px] uppercase tracking-[.2em]">
      Less busywork. More possibility.
    </p>
    <h1 class="mb-6 mt-5 font-serif text-5xl leading-[1.05] tracking-tight">
      Big ideas. One clear workspace.
    </h1>
    <p class="max-w-md text-sm leading-7">
      Bring your team, projects, and momentum together. A calmer way to do your
      best work.
    </p>
    <a
      href="#explore"
      class="mt-7 inline-flex min-h-11 items-center rounded-lg bg-t-accent px-5 text-sm text-t-accent-ink"
    >
      Find your plan ↗
    </a>
  </div>
  <div
    aria-hidden="true"
    class="rounded-2xl border border-current/20 bg-white p-6 shadow-xl"
  >
    <div class="mb-6 text-sm font-semibold">Your workspace, in focus.</div>
    <div class="grid grid-cols-3 gap-3">
      <div class="h-36 rounded-lg bg-blue-100 p-3 text-xs">
        To explore
        <br />
        <br />
        Brand direction
      </div>
      <div class="h-36 rounded-lg bg-violet-100 p-3 text-xs">
        In progress
        <br />
        <br />
        Website launch
      </div>
      <div class="h-36 rounded-lg bg-green-100 p-3 text-xs">
        Ready to share
        <br />
        <br />
        New ideas ↗
      </div>
    </div>
  </div>
</section>
<section
  data-motion-reveal
  id="explore"
  class="mx-auto max-w-5xl scroll-mt-6 px-6 py-12"
>
  <Pricing client:visible={{ rootMargin: "200px" }} />
</section>
<section
  data-motion-reveal
  id="about"
  class="mx-auto max-w-5xl border-t border-current/20 px-6 py-10"
>
  <h2 class="font-serif text-2xl">A little more about us</h2>
  <p class="mt-4 max-w-xl text-sm leading-7">
    Tally helps small teams find focus. Bring your work into one place and spend
    more time on the things you love building.
  </p>
</section>
<footer class="border-t border-current/15 px-6 py-6 text-center text-xs">
  Tally · An interactive Template Hub demo
</footer>
