---
import Menu from "./Menu";
import { Image } from "astro:assets";
import photo from "@/assets/photos/restaurant.jpg";
---

<header class="mx-auto flex max-w-5xl items-center justify-between gap-4 border-b border-current/15 px-6 py-5">
  <a
    href="#main"
    class="flex min-h-11 items-center font-serif text-2xl font-bold"
  >
    Sinag Kitchen
  </a>
  <nav aria-label="Demo navigation" class="flex flex-wrap gap-4 text-xs">
    <a class="flex min-h-11 items-center" href="#explore">
      Menu
    </a>
    <a class="flex min-h-11 items-center" href="#about">
      About
    </a>
  </nav>
</header>
<section
  data-motion-reveal
  class="mx-auto grid max-w-5xl items-center gap-8 px-6 py-12 md:grid-cols-2"
>
  <div>
    <p class="text-[10px] uppercase tracking-[.2em]">
      Gather. Taste. Remember.
    </p>
    <h1 class="mb-6 mt-5 font-serif text-5xl leading-[1.05] tracking-tight">
      A seat at our table.
    </h1>
    <p class="max-w-md text-sm leading-7">
      Seasonal ingredients. Familiar flavors, reimagined. Good company. Welcome
      to your new favorite evening.
    </p>
    <a
      href="#explore"
      class="mt-7 inline-flex min-h-11 items-center rounded-lg bg-t-accent px-5 text-sm text-t-accent-ink"
    >
      Explore the menu ↗
    </a>
  </div>
  <Image
    src={photo}
    alt="An intimate restaurant table ready for dinner"
    width={900}
    height={650}
    widths={[400, 640, 900]}
    sizes="(min-width: 1024px) 472px, (min-width: 768px) calc(50vw - 40px), calc(100vw - 48px)"
    loading="eager"
    fetchpriority="high"
    class="h-72 w-full rounded-xl object-cover sm:h-96"
  />
</section>
<section
  data-motion-reveal
  id="explore"
  class="mx-auto max-w-5xl scroll-mt-6 px-6 py-12"
>
  <Menu client:visible={{ rootMargin: "200px" }} />
</section>
<section
  data-motion-reveal
  id="about"
  class="mx-auto max-w-5xl border-t border-current/20 px-6 py-10"
>
  <h2 class="font-serif text-2xl">Find us around the table</h2>
  <p class="mt-4 max-w-xl text-sm leading-7">
    Poblacion, Makati · Tuesday–Sunday, 5 PM–10 PM. Walk-ins welcome. This is a
    demonstration restaurant.
  </p>
</section>
<footer class="border-t border-current/15 px-6 py-6 text-center text-xs">
  Sinag Kitchen · An interactive Template Hub demo
</footer>
