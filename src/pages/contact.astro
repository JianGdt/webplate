---
import { getCollection } from "astro:content";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ProjectInquiry from "@/components/portfolio/ProjectInquiry";
import { portfolio } from "@/lib/portfolio";
const templates = (await getCollection("templates"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({
    slug: data.slug,
    name: data.name,
    category: data.category,
  }));
---

<BaseLayout
  title="Discuss your project — Webplate"
  description="Talk to Webplate about a custom website, storefront, CMS, CRM, or inventory dashboard for your business."
>
  <main id="main" class="mx-auto max-w-6xl px-4 py-12 md:px-12 md:py-16">
    <a
      href="/#templates"
      class="mb-7 inline-flex min-h-11 items-center text-sm text-hub-muted"
    >
      ← Explore the demos
    </a>
    <p class="mb-4 font-mono text-xs uppercase tracking-[.12em] text-hub-muted">
      Let's build something useful
    </p>
    <h1
      data-motion-reveal
      class="max-w-[700px] text-balance font-display text-4xl font-extrabold tracking-tight sm:text-5xl"
    >
      Discuss your project
    </h1>
    <p class="mt-5 max-w-[65ch] text-[17px] leading-relaxed text-hub-muted">
      Share a few details about your business and what you want to build. Start
      from a demo, or tell me about your own idea.
    </p>
    <div class="mt-12 grid min-w-0 gap-9 lg:grid-cols-[minmax(0,1fr)_280px]">
      <ProjectInquiry templates={templates} client:idle />
      <aside
        data-motion-reveal
        class="self-start rounded-xl border border-hub-line bg-hub-panel p-6"
      >
        <h2 class="font-display text-[22px] font-bold">
          Prefer a direct conversation?
        </h2>
        <a
          href={`mailto:${portfolio.email}`}
          class="mt-4 flex min-h-11 items-center break-all text-sm text-hub-accent underline underline-offset-4"
        >
          {portfolio.email}
        </a>
        <p class="mt-5 text-sm text-hub-muted">
          If we met on a freelance platform, you can copy your brief and
          continue our conversation there.
        </p>
        <h3 class="mt-7 font-semibold">What happens next</h3>
        <p class="mt-3 text-sm text-hub-muted">
          We review your goals and agree on the features, timeline, and price
          before development begins.
        </p>
        <p class="mt-7 border-t border-hub-line pt-5 text-[13px] text-hub-muted">
          This page prepares an email. Your details are not stored on this site
          or submitted to a server.
        </p>
      </aside>
    </div>
  </main>
</BaseLayout>
