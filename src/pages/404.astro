---
import BaseLayout from "@/components/layout/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Template Hub"
  description="Find a fresh starting point in the Template Hub gallery."
>
  <main id="main" class="mx-auto max-w-3xl px-6 py-32">
    <p class="text-muted">404 / A small detour</p>
    <h1 class="my-6 text-5xl">Let's find your starting point.</h1>
    <a
      class="inline-flex min-h-11 items-center rounded-lg bg-moss px-5 text-white"
      href="/"
    >
      Back to the gallery →
    </a>
  </main>
</BaseLayout>
